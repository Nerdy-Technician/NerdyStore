# Copy to .env before starting.
# SECRET_KEY_BASE must be at least 64 bytes. Generate with: openssl rand -base64 48
# Use letters and numbers in PLAUSIBLE_DB_PASSWORD (it is embedded in DATABASE_URL).
BASE_URL=http://localhost:8000
SECRET_KEY_BASE=replace-with-at-least-64-bytes-of-random-data
PLAUSIBLE_DB_PASSWORD=replace-with-a-long-random-password
